# ---------------------------------------------------------------------------
# YukiTunnel Docker Compose configuration
# Copy to .env and edit before running:  cp .env.example .env
# ---------------------------------------------------------------------------

# --- image ---------------------------------------------------------------
# Leave empty (or keep the local tag) to build from source on first run.
# For production pin a published tag, e.g.
#   YUKI_IMAGE=ghcr.io/yuuuuukiu/yuki-server:0.1.0
YUKI_IMAGE=yukitunnel/server:local
# After v0.1.0 is published you can switch to the registry image:
#   YUKI_IMAGE=ghcr.io/yuuuuukiu/yuki-server:0.1.0

# --- networking ----------------------------------------------------------
# WebUI + REST API (HTTPS). Put a reverse proxy in front if you need 443.
API_PORT=8443
# Tunnel control endpoint used by clients (WSS). Must be reachable publicly.
CONTROL_PORT=9443
# Public ports handed out to tunnels. Keep this range identical to
# YUKI_PORT_MIN..YUKI_PORT_MAX and open it in your firewall / security group.
PORT_RANGE_START=20000
PORT_RANGE_END=20100

# --- first-run bootstrap -------------------------------------------------
# The public IP or domain clients will connect to for tunnels.
YUKI_PUBLIC_HOST=
YUKI_ADMIN_USERNAME=admin
# Leave empty to generate a random password written to /data/admin.txt
YUKI_ADMIN_PASSWORD=
YUKI_DOMAIN_BINDING=false
YUKI_DOMAIN_SUFFIX=

# --- runtime -------------------------------------------------------------
YUKI_PORT_MIN=20000
YUKI_PORT_MAX=20100
YUKI_TOKEN_TTL_HOURS=168
YUKI_LOG_LEVEL=info
TZ=Asia/Shanghai
